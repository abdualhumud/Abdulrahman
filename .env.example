# ============================================================
# REMS — Environment Variables Template
# Copy to .env and fill in real values. NEVER commit .env.
# ============================================================

# Database
DATABASE_URL=postgresql://rems:your_password@localhost:5432/rems
REDIS_URL=redis://:your_redis_password@localhost:6379

# Application
NODE_ENV=development
PORT=3000
JWT_SECRET=replace_with_256_bit_random_secret
JWT_EXPIRY=3600

# Booking.com
BOOKING_COM_API_KEY=
BOOKING_COM_HOTEL_ID=
BOOKING_COM_WEBHOOK_SECRET=

# Airbnb
AIRBNB_ACCESS_TOKEN=
AIRBNB_LISTING_ID=
AIRBNB_WEBHOOK_SECRET=

# Gathern
GATHERN_API_KEY=
GATHERN_LISTING_ID=
GATHERN_WEBHOOK_SECRET=

# Docker (override for dev)
POSTGRES_PASSWORD=rems_dev_password
REDIS_PASSWORD=rems_dev_redis
