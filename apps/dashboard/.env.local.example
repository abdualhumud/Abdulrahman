# ─────────────────────────────────────────────────────────────
# REMS — Environment Variables
# Copy this file to .env.local and fill in your values.
# .env.local is gitignored — never commit real keys.
# ─────────────────────────────────────────────────────────────

# Supabase — get from: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY_HERE

# EmailJS — lead alert emails (emailjs.com)
# Service ID:   Email Services tab
# Template ID:  Email Templates tab
# Public Key:   Account → General
NEXT_PUBLIC_EMAILJS_SERVICE_ID=service_xxxxxxx
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=template_xxxxxxx
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=xxxxxxxxxxxxxxxxxxxx

# Optional: Google Sheets webhook (Apps Script Web App URL)
# NEXT_PUBLIC_SHEETS_WEBHOOK=https://script.google.com/macros/s/.../exec

# Optional: Moyasar payment gateway
# NEXT_PUBLIC_MOYASAR_KEY=pk_live_...

# Optional: SPL National Address API
# NEXT_PUBLIC_SPL_API_KEY=your_spl_key_here
